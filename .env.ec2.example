# ===================================
# Web Server Configuration (i-c, EC2)
# ===================================

# Node Environment
NODE_ENV=production

# Database Configuration (RDS PostgreSQL)
DATABASE_URL=postgresql://postgres:<password>@<RDS PostgreSQL Endpoint>:5432/kishax

# NextAuth Configuration
NEXTAUTH_URL=https://kishax.net
NEXTAUTH_SECRET=<Generate 32+ character random string>

# OAuth Providers
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from SSM: /kishax/production/oauth/google-client-secret>
DISCORD_CLIENT_ID=<from Discord Developer Portal>
DISCORD_CLIENT_SECRET=<from SSM: /kishax/production/oauth/discord-client-secret>
TWITTER_CLIENT_ID=<from Twitter Developer Portal>
TWITTER_CLIENT_SECRET=<from SSM: /kishax/production/oauth/twitter-client-secret>

# Email Configuration (SMTP)
EMAIL_HOST=<SMTP Host>
EMAIL_PORT=587
EMAIL_USER=<SMTP User>
EMAIL_PASS=<from SSM: /kishax/production/email/smtp-password>
EMAIL_FROM=noreply@kishax.net

# Redis Configuration (i-b host Redis #2)
REDIS_URL=redis://10.0.36.61:6380

# Internal API Key
INTERNAL_API_KEY=<from SSM: /kishax/production/api/internal-key>
