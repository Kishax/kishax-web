{
  "name": "kishax-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:full": "concurrently \"npm run dev\" \"npm run redis:checker\"",
    "redis:checker": "tsx src/scripts/redis-checker.ts",
    "build": "next build && npm run build:scripts",
    "build:scripts": "tsc -p tsconfig.build.json",
    "start": "concurrently \"next start\" \"node dist/scripts/redis-checker.js\"",
    "lint": "next lint",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.16.2",
    "@scalar/api-reference": "^1.40.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.0.7",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.11",
    "openapi-types": "^12.1.3",
    "openapi-typescript": "^7.8.0",
    "pg": "^8.16.3",
    "react": "19.2.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.62.0",
    "redis": "^5.8.2",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "tsx": "^4.19.2",
    "eslint-config-next": "16.0.7",
    "playwright": "^1.56.1",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.0"
  }
}
